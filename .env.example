# --- Build-time (frontend) ---------------------------------------------
# Baked into the JS bundle when the Docker image is built. Pass this as a
# Docker --build-arg / Coolify "Build Variable", not a plain runtime env
# var — see DEPLOYMENT.md.
VITE_LIFF_ID=

# --- Runtime (backend) ---------------------------------------------------
# Channel ID of the LINE LOGIN (or LINE MINI App) channel that hosts the
# LIFF app — NOT the Messaging API channel. Used as the expected "aud"
# when verifying LIFF ID tokens. See DEPLOYMENT.md: LIFF can no longer be
# added directly to a Messaging API channel, so this is a second channel
# under the same Provider as your Messaging API channel below.
LINE_CHANNEL_ID=

# A channel access token for your separate MESSAGING API channel (the
# Official Account), used to call the Messaging API push endpoint. Treat
# as a secret. See DEPLOYMENT.md for why this is a different channel
# than LINE_CHANNEL_ID above.
LINE_CHANNEL_ACCESS_TOKEN=

# The public HTTPS origin this service is reachable at once deployed —
# e.g. https://complaints.yourdomain.com (no trailing slash). Used to
# build the image URLs LINE's servers fetch for the image messages.
PUBLIC_BASE_URL=
