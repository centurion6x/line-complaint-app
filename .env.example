# --- Build-time (frontend) ---------------------------------------------
# Baked into the JS bundle when the Docker image is built. Pass this as a
# Docker --build-arg / Coolify "Build Variable", not a plain runtime env
# var — see DEPLOYMENT.md.
VITE_LIFF_ID=

# --- Runtime (backend) ---------------------------------------------------
# Channel ID of your Messaging API channel (also the LIFF app's channel).
# Used as the expected "aud" when verifying LIFF ID tokens.
LINE_CHANNEL_ID=

# A channel access token for that same channel, used to call the
# Messaging API push endpoint. Treat as a secret.
LINE_CHANNEL_ACCESS_TOKEN=

# The public HTTPS origin this service is reachable at once deployed —
# e.g. https://complaints.yourdomain.com (no trailing slash). Used to
# build the image URLs LINE's servers fetch for the image messages.
PUBLIC_BASE_URL=
